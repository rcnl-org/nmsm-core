<NMSMPipelineDocument Version="1.5.0">
	<NeuralControlPersonalizationTool name="default">
		<!--*Required* Directory name
		Description: Directory that results are written to. Receives synergyWeights.sto, the per trial result files, the .osimx results file, a copy of this settings file and commandWindowOutput.txt; leave it empty to use the directory the tool is run from.
		Default: N/A-->
		<results_directory>NCPResults</results_directory>
		<!--*Required* .osim model
		Description: OpenSim model whose muscles are fit with synergies. The muscle groups named in <RCNLSynergySet>, <activation_muscle_groups> and <normalized_fiber_length_muscle_groups> must exist in it.
		Default: N/A-->
		<input_model_file>model.osim</input_model_file>
		<!--*Optional* .osimx file
		Description: An osimx file created by previous MTP or GCP runs. New results are added to its contents and written to <name>_ncp.xml in <results_directory>; it must hold MTP results when <mtp_results_directory> is set.
		Default: empty, a new osimx file named after <input_model_file> is built.-->
		<input_osimx_file>model.osimx</input_osimx_file>
		<!--*Required* Directory name
		Description: Directory holding the preprocessed trial data. Must contain IDData and MAData subdirectories, plus synergyWeights.sto when <optimize_synergy_vectors> is false.
		Default: N/A-->
		<data_directory>NCPInputsDir</data_directory>
		<!--*Required* List of strings
		Description: Coordinates whose inverse dynamics moments NCP tracks. Muscles spanning these coordinates are found automatically, and only those in a synergy group are optimized.
		Default: N/A-->
		<coordinate_list>coordinate_1 coordinate_2 coordinate_3</coordinate_list>
		<!--*Optional* Double
		Description: Multiplier on optimal fiber length giving each muscle's maximum shortening velocity. Used by the force velocity curve.
		Default: 10-->
		<v_max_factor>10</v_max_factor>
		<!--*Required* List of strings
		Description: Model muscle groups for the grouped_activations cost term. Each name must be a muscle group in the model.
		Default: N/A-->
		<activation_muscle_groups>activation_group_1 activation_group_2 activation_group_3</activation_muscle_groups>
		<!--*Required* List of strings
		Description: Model muscle groups for the grouped fiber length cost terms. Used by grouped_fiber_lengths and by the grouped MuscleTendonLengthInitialization terms when that stage is enabled.
		Default: N/A-->
		<normalized_fiber_length_muscle_groups>fiber_length_group_1 fiber_length_group_2 fiber_length_group_3</normalized_fiber_length_muscle_groups>
		<!--*Optional* List of strings
		Description: Trial names to use in this NCP run. Only files in <data_directory> whose names contain one of these prefixes are used.
		Default: every trial in <data_directory>.-->
		<trial_prefixes>gait_1 gait_2 gait_3</trial_prefixes>
		<!--*Required* Element
		Description: Settings for the MuscleTendonLengthInitialization stage. When enabled it runs before the synergy optimization and updates the muscle parameters NCP uses; the element must be present even when the stage is disabled.
		Default: N/A-->
		<MuscleTendonLengthInitialization>
			<!--*Required* Boolean
			Description: Whether muscle tendon length initialization runs before NCP. When false the rest of this element is ignored; when true a <passive_data_input_directory> element must also be added here, left empty to run without passive data.
			Default: N/A-->
			<is_enabled>false</is_enabled>
			<!--*Required* Double
			Description: Target maximum normalized fiber length. The grouped maximum normalized fiber length design variables are pulled toward it; only the grouped_maximum_normalized_muscle_fiber_length term reads it.
			Default: N/A-->
			<max_normalized_muscle_fiber_length>1</max_normalized_muscle_fiber_length>
			<!--*Required* Double
			Description: Minimum allowed normalized fiber length. Muscles falling below it are penalized; only the minimum_normalized_muscle_fiber_length term reads it.
			Default: N/A-->
			<min_normalized_muscle_fiber_length>0.6</min_normalized_muscle_fiber_length>
			<!--*Required* Boolean
			Description: Whether the shared maximum muscle stress is adjusted. When true one extra design variable, bounded between 0.6 and 2.3, scales <maximum_muscle_stress>.
			Default: N/A-->
			<optimize_maximum_muscle_stress>true</optimize_maximum_muscle_stress>
			<!--*Optional* Boolean
			Description: Whether maximum isometric forces follow changes in muscle properties. Holds muscle volume constant while fiber lengths change.
			Default: true-->
			<optimize_isometric_max_force>true</optimize_isometric_max_force>
			<!--*Optional* Double
			Description: Initial maximum muscle stress, in Pa. Shared by all muscles; it also sets the muscle volume used by <optimize_isometric_max_force>.
			Default: 610000-->
			<maximum_muscle_stress>610000</maximum_muscle_stress>
			<!--*Required* Set of RCNLCostTerm elements
			Description: Cost terms for the MuscleTendonLengthInitialization stage. The stage runs lsqnonlin with fixed settings (at most 100 iterations); the optimizer settings at the end of this file do not apply to it.
			Default: N/A-->
			<RCNLCostTermSet>
				<!--Cost terms in MTLI can have up to 4 elements:
				<is_enabled> is required for all cost terms and specifies whether or not to use the cost term.
				<type> is required for all cost terms and specifies which cost term is used.
				<max_allowable_error> is required for all cost terms and specifies the value that the error is divided by before being squared; smaller values give the term more weight.
				<error_center> is used by certain cost terms and specifies the point that errors are calculated about. If a cost term does not use an error center, its entry in this document does not include one.-->
				<RCNLCostTerm>
					<!--Description: passive_joint_moment tracks passive trial inverse dynamics moments with the model's passive muscle moments. Needs <passive_data_input_directory> to name an existing folder, and raises an error otherwise.-->
					<is_enabled>true</is_enabled>
					<type>passive_joint_moment</type>
					<max_allowable_error>2</max_allowable_error>
				</RCNLCostTerm>
				<RCNLCostTerm>
					<!--Description: optimal_muscle_fiber_length pulls the optimal fiber length scale factors toward <error_center>. Keeps optimal fiber lengths near their model values; set <error_center> to 1, because the default of 0 would penalize the scale factors themselves.-->
					<is_enabled>true</is_enabled>
					<type>optimal_muscle_fiber_length</type>
					<max_allowable_error>0.3</max_allowable_error>
					<error_center>1</error_center>
				</RCNLCostTerm>
				<RCNLCostTerm>
					<!--Description: tendon_slack_length pulls the tendon slack length scale factors toward <error_center>. Keeps tendon slack lengths near their model values; set <error_center> to 1, because the default of 0 would penalize the scale factors themselves.-->
					<is_enabled>true</is_enabled>
					<type>tendon_slack_length</type>
					<max_allowable_error>1</max_allowable_error>
					<error_center>1</error_center>
				</RCNLCostTerm>
				<RCNLCostTerm>
					<!--Description: minimum_normalized_muscle_fiber_length penalizes muscles whose smallest normalized fiber length falls below <min_normalized_muscle_fiber_length>. Keeps fibers off the ascending limb of the force length curve.-->
					<is_enabled>true</is_enabled>
					<type>minimum_normalized_muscle_fiber_length</type>
					<max_allowable_error>0.3</max_allowable_error>
				</RCNLCostTerm>
				<RCNLCostTerm>
					<!--Description: maximum_normalized_muscle_fiber_length drives each muscle's largest normalized fiber length toward its grouped maximum design variable. Keeps fibers near the plateau of the force length curve.-->
					<is_enabled>true</is_enabled>
					<type>maximum_normalized_muscle_fiber_length</type>
					<max_allowable_error>0.03</max_allowable_error>
				</RCNLCostTerm>
				<RCNLCostTerm>
					<!--Description: maximum_muscle_stress pulls the shared maximum muscle stress scale factor toward <error_center>. Only has an effect when <optimize_maximum_muscle_stress> is true; an <error_center> of 1 leaves <maximum_muscle_stress> unchanged.-->
					<is_enabled>true</is_enabled>
					<type>maximum_muscle_stress</type>
					<max_allowable_error>0.1</max_allowable_error>
					<error_center>1.2</error_center>
				</RCNLCostTerm>
				<RCNLCostTerm>
					<!--Description: passive_muscle_force penalizes the passive fiber force of every muscle. Discourages solutions that hold the model up with passive tissue.-->
					<is_enabled>false</is_enabled>
					<type>passive_muscle_force</type>
					<max_allowable_error>10</max_allowable_error>
				</RCNLCostTerm>
				<RCNLCostTerm>
					<!--Description: grouped_normalized_muscle_fiber_length drives the muscles in each <normalized_fiber_length_muscle_groups> entry toward a common normalized fiber length. Keeps fiber operating ranges consistent within each group.-->
					<is_enabled>true</is_enabled>
					<type>grouped_normalized_muscle_fiber_length</type>
					<max_allowable_error>0.1</max_allowable_error>
				</RCNLCostTerm>
				<RCNLCostTerm>
					<!--Description: grouped_maximum_normalized_muscle_fiber_length pulls the grouped maximum normalized fiber length design variables toward <max_normalized_muscle_fiber_length>. That element is required whenever this term is enabled.-->
					<is_enabled>true</is_enabled>
					<type>grouped_maximum_normalized_muscle_fiber_length</type>
					<max_allowable_error>0.1</max_allowable_error>
				</RCNLCostTerm>
			</RCNLCostTermSet>
		</MuscleTendonLengthInitialization>
		<!--*Optional* Directory name
		Description: Directory holding MTP results. Its muscleActivations files become the activation_tracking target and seed the initial guess, and the MTP muscle parameters are read from <input_osimx_file>.
		Default: empty, NCP runs without MTP results.-->
		<mtp_results_directory>MTPResults</mtp_results_directory>
		<!--*Optional* Boolean
		Description: Whether the second synergy group reuses the first group's weights. Requires exactly two groups with the same number of muscles and synergies.
		Default: false-->
		<enforce_bilateral_symmetry>false</enforce_bilateral_symmetry>
		<!--*Optional* Boolean
		Description: Whether synergy weights are optimized along with the synergy commands. When false the weights are read from synergyWeights.sto in <data_directory> and held fixed.
		Default: true-->
		<optimize_synergy_vectors>true</optimize_synergy_vectors>
		<!--*Optional* Integer
		Description: Number of nodes representing each synergy command. Commands are optimized at these nodes and interpolated in time, so fewer nodes give a smoother, cheaper problem.
		Default: 26-->
		<number_of_nodes>26</number_of_nodes>
		<!--*Optional* String
		Description: How synergy weight vectors are normalized, 'sum' or 'magnitude'. 'sum' adds a linear constraint and 'magnitude' a nonlinear one; it is ignored when <optimize_synergy_vectors> is false.
		Default: magnitude-->
		<synergy_vector_normalization_method>magnitude</synergy_vector_normalization_method>
		<!--*Optional* Double
		Description: Target sum or magnitude for <synergy_vector_normalization_method>. Sets the constraint target and the scale of the initial guess; NaN means no target.
		Default: 10, which is also used when the element is empty.-->
		<synergy_vector_normalization_value>10</synergy_vector_normalization_value>
		<!--*Required* Set of RCNLCostTerm elements
		Description: Cost terms for the synergy optimization. grouped_activations and grouped_fiber_lengths are also accepted besides the types shown.
		Default: N/A-->
		<RCNLCostTermSet>
			<!--Cost terms in NCP can have up to 4 elements:
			<is_enabled> is required for all cost terms and specifies whether or not to use the cost term.
			<type> is required for all cost terms and specifies what cost term is being Used
			<max_allowable_error> is required for all cost terms that specifies the value that error is divided by before being squared.
			<error_center> is used for certain cost terms and specifies the point that errors are calculated about. If a cost does not have an error center, its entry in this document does not include an error center.-->
			<RCNLCostTerm>
				<!--Description: moment_tracking drives the synergy driven muscle moments toward the inverse dynamics moments of <coordinate_list>. The primary tracking term of the tool.-->
				<is_enabled>true</is_enabled>
				<type>moment_tracking</type>
				<max_allowable_error>10</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<!--Description: activation_tracking drives the muscles that have MTP results toward those activations. Create a synergy set that closely matches MTP activations-->
				<is_enabled>true</is_enabled>
				<type>activation_tracking</type>
				<max_allowable_error>0.05</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<!--Description: muscle_activation_minimization penalizes the activation of muscles without MTP activation data. If muscles do not have MTP activations to track, this term will minimize them instead. If muscles do have MTP activations to track, this term does nothing to them.-->
				<is_enabled>false</is_enabled>
				<type>muscle_activation_minimization</type>
				<max_allowable_error>0.05</max_allowable_error>
				<error_center>0</error_center>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<!--Description: synergy_activation_minimization penalizes the synergy commands themselves. Pulls each command toward an optional <error_center> (default 0); pair it with a normalization method that fixes the weight scale.-->
				<is_enabled>false</is_enabled>
				<type>synergy_activation_minimization</type>
				<max_allowable_error>0.05</max_allowable_error>
				<error_center>0</error_center>
			</RCNLCostTerm>
		</RCNLCostTermSet>
		<!--*Required* Set of RCNLSynergy elements
		Description: Synergy groups for the model. The groups are copied to the .osimx results file, which Treatment Optimization reads to build its synergy controller.
		Default: N/A-->
		<RCNLSynergySet>
			<!--*Required* Element
			Description: One group of muscles controlled by a shared set of synergies. Copy this element for each group, for example one per leg.
			Default: N/A-->
			<RCNLSynergy>
				<!--*Required* String
				Description: Model muscle group controlled by this set of synergies. Groups should not overlap, and only muscles that also span <coordinate_list> are optimized.
				Default: N/A-->
				<muscle_group_name>right_leg</muscle_group_name>
				<!--*Required* Integer
				Description: Number of synergies in this group. Synergies are referenced elsewhere as <muscle_group_name>_<index>, for example right_leg_2.
				Default: N/A-->
				<num_synergies>5</num_synergies>
			</RCNLSynergy>
		</RCNLSynergySet>
		<!--*Optional* Double
		Description: Minimum finite difference step of fmincon (DiffMinChange). Sets the smallest step used to estimate gradients.
		Default: 1e-6-->
		<diff_min_change>0.0001</diff_min_change>
		<!--*Optional* Double
		Description: Step tolerance of fmincon. Larger values stop the optimizer sooner, with lower accuracy.
		Default: 1e-16-->
		<step_tolerance>1e-6</step_tolerance>
		<!--*Optional* Double
		Description: Optimality tolerance of fmincon. Larger values stop the optimizer sooner, with lower accuracy.
		Default: 1e-3-->
		<optimality_tolerance>1e-6</optimality_tolerance>
		<!--*Optional* Double
		Description: Function tolerance of fmincon. Larger values stop the optimizer sooner, with lower accuracy.
		Default: 1e-6-->
		<function_tolerance>1e-6</function_tolerance>
		<!--*Optional* Integer
		Description: Maximum number of fmincon iterations. Lowering it can help cancel an optimization that will not converge.
		Default: 1000-->
		<max_iterations>1000</max_iterations>
		<!--*Optional* Integer
		Description: Maximum number of cost function calls. Lowering it can help cancel an optimization that will not converge.
		Default: 1000000-->
		<max_function_evaluations>100000000</max_function_evaluations>
	</NeuralControlPersonalizationTool>
</NMSMPipelineDocument>