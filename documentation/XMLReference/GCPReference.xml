<NMSMPipelineDocument Version="1.5.0">
	<GroundContactPersonalizationTool name="default">
		<!--*Required* Directory name
		Description: Directory that results are written to. Receives the .osimx results file, the result .sto files, a copy of this settings file and commandWindowOutput.txt. Leave it empty to use the directory the tool is run from.
		Default: N/A-->
		<results_directory>GCPResults</results_directory>
		<!--*Optional* Directory name
		Description: Directory prefixed to <input_motion_file> and <input_grf_file>. Lets the data file names stay short. It is not applied to <input_model_file> or <input_osimx_file>.
		Default: the directory the tool is run from.-->
		<input_directory>GCPInputsDir</input_directory>
		<!--*Required* .osim model
		Description: OpenSim model that the contact surfaces are added to. Every body and marker named below must exist in this model.
		Default: N/A-->
		<input_model_file>model.osim</input_model_file>
		<!--*Optional* .osimx file
		Description: An osimx file created by previous MTP or GCP runs. New results are added to its contents and written to <name>_gcp.xml in <results_directory>.
		Default: empty, a new osimx file named after <input_model_file> is built.-->
		<input_osimx_file>model.osimx</input_osimx_file>
		<!--*Required* .mot or .sto file
		Description: Full body inverse kinematics for the trial, relative to <input_directory> or the settings file directory. Supplies the foot kinematics. its time points must match <input_grf_file> to within 0.005 s. 
		Default: N/A-->
		<input_motion_file>GCPInputsDir\IKData\trial.sto</input_motion_file>
		<!--*Required* .mot or .sto file
		Description: Measured ground reactions for the trial, relative to <input_directory> or the settings file directory. Must contain every column named in <force_columns>, <moment_columns> and <electrical_center_columns> of every enabled surface.
		Default: N/A-->
		<input_grf_file>GCPInputsDir\GRFData\trial.sto</input_grf_file>
		<!--*Optional* Double
		Description: Lowpass cutoff frequency, in Hz, of the kinematic B-splines. A lower frequency may be less precise but converges more quickly.
		Default: 6-->
		<kinematics_filter_cutoff>10</kinematics_filter_cutoff>
		<!--*Optional* Boolean
		Description: Whether the resting spring length is calibrated before the optimization rounds. Recommended unless the value in <initial_resting_spring_length> is wanted, since it overrides that value.
		Default: true-->
		<initialize_resting_spring_length>true</initialize_resting_spring_length>
		<!--*Optional* Integer
		Description: Number of spring markers across the width of the spring marker grid. Each foot gets grid_width times grid_height springs, so larger grids cost more run time.
		Default: 5-->
		<grid_width>5</grid_width>
		<!--*Optional* Integer
		Description: Number of spring markers along the length of the spring marker grid. Each foot gets grid_width times grid_height springs.
		Default: 15-->
		<grid_height>15</grid_height>
		<!--*Required* Set of GCPContactSurface elements
		Description: Contact surfaces to personalize. At least one surface must be enabled. All surfaces share one set of spring, damping and friction parameters.
		Default: N/A-->
		<GCPContactSurfaceSet>
			<!--*Required* Element with a name attribute
			Description: One contact surface, normally one foot. Copy the element to personalize both feet in one run. The name is only a label and does not change any functionality.
			Default: N/A-->
			<GCPContactSurface name="Right foot">
				<!--*Required* Boolean
				Description: Indicate whether this surface is personalized. Must be 'true' or 'false'. A disabled surface is ignored entirely.
				Default: N/A-->
				<is_enabled>true</is_enabled>
				<!--*Required* Boolean
				Description: Whether this surface is a left foot. Set true for a left foot so the spring grid is mirrored.
				Default: N/A-->
				<is_left_foot>false</is_left_foot>
				<!--*Required* Double
				Description: Start time, in seconds, of this side's gait cycle. The first frame at or after this time in the motion and ground reaction files is used.
				Default: N/A-->
				<start_time>0</start_time>
				<!--*Required* Double
				Description: End time, in seconds, of this side's gait cycle. The motion and ground reaction files must yield the same frames over this range.
				Default: N/A-->
				<end_time>1</end_time>
				<!--*Required* Double
				Description: Treadmill belt speed for the recorded motion, in model length units per second. Used in the slip velocity of the friction model. Set it to 0 for overground data.
				Default: N/A-->
				<belt_speed>1</belt_speed>
				<!--*Required* List of 3 strings
				Description: Force column names in the grf file, ordered X, Y, Z. Identify this surface's measured forces.
				Default: N/A-->
				<force_columns>ground_force_1_vx ground_force_1_vy ground_force_1_vz</force_columns>
				<!--*Required* List of 3 strings
				Description: Moment column names in the grf file, ordered X, Y, Z. Identify this surface's measured moments.
				Default: N/A-->
				<moment_columns>ground_moment_1_mx ground_moment_1_my ground_moment_1_mz</moment_columns>
				<!--*Required* List of 3 strings
				Description: Electrical center column names in the grf file, ordered X, Y, Z. Identify the force plate application points that the electricalCenterX, Y and Z design variables shift.
				Default: N/A-->
				<electrical_center_columns>ground_force_1_px ground_force_1_py ground_force_1_pz</electrical_center_columns>
				<!--*Required* String
				Description: Name of the hindfoot body in the model. The spring marker grid is built on this body.
				Default: N/A-->
				<hindfoot_body>calcn_r</hindfoot_body>
				<!--*Required* String
				Description: Name of the toe marker. Bounds the front of the spring marker grid and is tracked by the marker_position and marker_slope cost terms.
				Default: N/A-->
				<toe_marker>R_Toe</toe_marker>
				<!--*Required* String
				Description: Name of the medial marker. Bounds one side of the spring marker grid and is tracked by the marker_position and marker_slope cost terms.
				Default: N/A-->
				<medial_marker>R_Toe_Medial</medial_marker>
				<!--*Required* String
				Description: Name of the lateral marker. Bounds the other side of the spring marker grid and is tracked by the marker_position and marker_slope cost terms.
				Default: N/A-->
				<lateral_marker>R_Toe_Lateral</lateral_marker>
				<!--*Required* String
				Description: Name of the heel marker. Bounds the back of the spring marker grid and is tracked by the marker_position and marker_slope cost terms.
				Default: N/A-->
				<heel_marker>R_Heel</heel_marker>
				<!--*Required* String
				Description: Name of the midfoot superior marker. Measured moments are transferred to the point beneath it before they are tracked, and it is tracked by the marker_position and marker_slope cost terms.
				Default: N/A-->
				<midfoot_superior_marker>R_Midfoot_Superior</midfoot_superior_marker>
			</GCPContactSurface>
		</GCPContactSurfaceSet>
		<!--*Required* List of GCPTask elements
		Description: Rounds of GCP optimization. Each enabled task is a separate optimization, run in <index> order from the values left by the previous task.
		Default: N/A-->
		<GCPTaskList>
			<!--*Required* Element
			Description: One optimization round. Copy this element to release design variables gradually.
			Default: N/A-->
			<GCPTask>
				<!--*Required* Boolean
				Description: Indicate whether the task is enabled or not. Must be 'true' or 'false'. A disabled task is skipped entirely.
				Default: N/A-->
				<is_enabled>true</is_enabled>
				<!--*Required* Integer
				Description: Order in which this task is completed, smallest first. It is not read when a single task is present, but omitting it with several tasks is an error.
				Default: N/A-->
				<index>1</index>
				<!--*Optional* Boolean
				Description: Whether each spring marker's stiffness is optimized in this round. The stiffness values are shared by every contact surface.
				Default: false-->
				<springConstants>true</springConstants>
				<!--*Optional* Boolean
				Description: Whether the damping factor of the vertical force is optimized in this round. The value is shared by every contact surface.
				Default: false-->
				<dampingFactor>true</dampingFactor>
				<!--*Optional* Boolean
				Description: Whether the dynamic friction coefficient is optimized in this round. This value is shared by every contact surface.
				Default: false-->
				<dynamicFrictionCoefficient>true</dynamicFrictionCoefficient>
				<!--*Optional* Boolean
				Description: Whether the viscous friction coefficient is optimized in this round. This value is shared by every contact surface.
				Default: false-->
				<viscousFrictionCoefficient>true</viscousFrictionCoefficient>
				<!--*Optional* Boolean
				Description: Whether the height at which the springs start to exert force is optimized in this round. Only recommended when mainly calibrating vertical force. This value is shared by every contact surface.
				Default: false-->
				<restingSpringLength>true</restingSpringLength>
				<!--*Optional* Boolean
				Description: Whether the foot kinematics may be adjusted in this round. Each contact surface gets its own set of B-spline coefficients.
				Default: false-->
				<kinematicsBSplineCoefficients>true</kinematicsBSplineCoefficients>
				<!--*Optional* Boolean
				Description: Whether the force plate electrical center is shifted along x, changing ground reaction moments.
				Default: false-->
				<electricalCenterX>true</electricalCenterX>
				<!--*Optional* Boolean
				Description: Whether the force plate electrical center is shifted along y, changing ground reaction moments.
				Default: false-->
				<electricalCenterY>true</electricalCenterY>
				<!--*Optional* Boolean
				Description: Whether the force plate electrical center is shifted along z, changing ground reaction moments.
				Default: false-->
				<electricalCenterZ>true</electricalCenterZ>
				<!--*Optional* Boolean
				Description: Whether the force plate is rotated about the y axis. One rotation per surface, bounded to plus or minus 15 degrees, is applied to the measured forces and moments.
				Default: false-->
				<forcePlateRotation>true</forcePlateRotation>
				<!--*Optional* Double
				Description: Standard deviation of the gaussian weighting in the neighbor_spring_constant cost term. Larger values smooth stiffness over a wider neighborhood.
				Default: 0.05-->
				<neighborStandardDeviation>0.2</neighborStandardDeviation>
				<!--*Required* Set of RCNLCostTerm elements
				Description: Cost terms for this round. Only enabled terms contribute, so each round can track a different set of quantities.
				Default: N/A-->
				<RCNLCostTermSet>
					<!--Cost terms in GCP have 3 elements:
					<is_enabled> is required for all cost terms and specifies whether or not to use the cost term.
					<type> is required for all cost terms and specifies which cost term is used.
					<max_allowable_error> is required for all cost terms and specifies the value that the error is divided by before being squared, in the units of the tracked quantity. smaller values give the term more weight.
					The <max_allowable_error> values in this file are left empty, so fill them in: an empty element parses as NaN.-->
					<RCNLCostTerm>
						<!--Description: marker_position tracks the five foot marker positions against the experimental foot kinematics. Keeps the adjusted foot kinematics close to the measured motion.-->
						<is_enabled>true</is_enabled>
						<type>marker_position</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: marker_slope tracks the velocities of the same five foot markers. Keeps modeled and measured foot motion in phase.-->
						<is_enabled>true</is_enabled>
						<type>marker_slope</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: rotation penalizes changes to the four rotational foot coordinates. Limits how far kinematicsBSplineCoefficients move the foot rotations from the experimental kinematics. no effect unless those coefficients are optimized.-->
						<is_enabled>true</is_enabled>
						<type>rotation</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: translation penalizes changes to the three translational foot coordinates. Limits how far kinematicsBSplineCoefficients move the foot translations from the experimental kinematics. no effect unless those coefficients are optimized.-->
						<is_enabled>true</is_enabled>
						<type>translation</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: kinematic_periodicity drives the first and last frames of the adjusted foot kinematics together. Keeps the foot motion cyclic. the error is normalized by the measured first to last difference.-->
						<is_enabled>true</is_enabled>
						<type>kinematic_periodicity</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: vertical_grf tracks the measured vertical ground reaction force. Calibrates the spring stiffness, resting length and damping, which mainly control vertical force.-->
						<is_enabled>true</is_enabled>
						<type>vertical_grf</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: vertical_grf_slope tracks the time derivative of the measured vertical ground reaction force. Sharpens the timing of loading and unloading.-->
						<is_enabled>true</is_enabled>
						<type>vertical_grf_slope</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: horizontal_grf tracks the measured anterior and lateral ground reaction forces. Calibrates the friction coefficients, which mainly control horizontal force.-->
						<is_enabled>true</is_enabled>
						<type>horizontal_grf</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: horizontal_grf_slope tracks the time derivatives of the measured anterior and lateral ground reaction forces. Matches the shape of the horizontal forces over the gait cycle.-->
						<is_enabled>true</is_enabled>
						<type>horizontal_grf_slope</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: ground_reaction_moment tracks the three measured ground reaction moment components. Moments are compared about the point below <midfoot_superior_marker>.-->
						<is_enabled>true</is_enabled>
						<type>ground_reaction_moment</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: ground_reaction_moment_slope tracks the time derivatives of the measured ground reaction moments. Matches the shape of the moments over the gait cycle.-->
						<is_enabled>true</is_enabled>
						<type>ground_reaction_moment_slope</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: spring_constant_mean pulls every spring stiffness toward the mean stiffness. Regularizes the stiffness distribution. it only matters when springConstants is true.-->
						<is_enabled>true</is_enabled>
						<type>spring_constant_mean</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: neighbor_spring_constant pulls each spring stiffness toward the gaussian weighted average of its neighbors. Smooths the stiffness distribution using <neighborStandardDeviation>. its residual is raised to the fourth power, so isolated outliers are penalized strongly.-->
						<is_enabled>true</is_enabled>
						<type>neighbor_spring_constant</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: electrical_center_regularization keeps the electrical center shifts small. An optional <axes> element (any of x, y, z) limits which shifts are penalized. it only matters when electricalCenterX, Y or Z is true.-->
						<is_enabled>true</is_enabled>
						<type>electrical_center_regularization</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<!--Description: force_plate_rotation_regularization keeps each surface's force plate rotation small. It only matters when forcePlateRotation is true.-->
						<is_enabled>true</is_enabled>
						<type>force_plate_rotation_regularization</type>
						<max_allowable_error></max_allowable_error>
					</RCNLCostTerm>
				</RCNLCostTermSet>
			</GCPTask>
		</GCPTaskList>
		<!--*Optional* Double
		Description: Initial resting spring length, in model length units. Starting value for restingSpringLength. it is overwritten before the first task when <initialize_resting_spring_length> is true.
		Default: 0.05-->
		<initial_resting_spring_length>0.05</initial_resting_spring_length>
		<!--*Optional* Double
		Description: Initial stiffness of every spring marker. Starting value for the springConstants design variables.
		Default: 2500-->
		<initial_spring_constant>2500</initial_spring_constant>
		<!--*Optional* Double
		Description: Initial damping factor. Starting value for the dampingFactor design variable.
		Default: 1e-4-->
		<initial_damping_factor>1</initial_damping_factor>
		<!--*Optional* Double
		Description: Initial dynamic friction coefficient. Starting value for the dynamicFrictionCoefficient design variable.
		Default: 0-->
		<initial_dynamic_friction_coefficient>0.5</initial_dynamic_friction_coefficient>
		<!--*Optional* Double
		Description: Initial viscous friction coefficient. Starting value for the viscousFrictionCoefficient design variable.
		Default: 5-->
		<initial_viscous_friction_coefficient>0</initial_viscous_friction_coefficient>
		<!--*Optional* Double
		Description: Latching velocity of the friction model, in model length units per second. Sets how quickly friction force saturates as slip velocity grows. It is not optimized.
		Default: 0.05-->
		<latching_velocity>0.1</latching_velocity>
		<!--*Optional* Double
		Description: Minimum finite difference step of lsqnonlin (DiffMinChange). Sets the smallest step used to estimate gradients.
		Default: 1e-6-->
		<diff_min_change>0.01</diff_min_change>
		<!--*Optional* Double
		Description: Step tolerance of lsqnonlin. Larger values stop the optimizer sooner, with lower accuracy.
		Default: 1e-6-->
		<step_tolerance>0.0001</step_tolerance>
		<!--*Optional* Double
		Description: Optimality tolerance of lsqnonlin. Larger values stop the optimizer sooner, with lower accuracy.
		Default: 1e-6-->
		<optimality_tolerance>0.0001</optimality_tolerance>
		<!--*Optional* Double
		Description: Function tolerance of lsqnonlin. Larger values stop the optimizer sooner, with lower accuracy.
		Default: 1e-6-->
		<function_tolerance>0.0001</function_tolerance>
		<!--*Optional* Integer
		Description: Maximum number of lsqnonlin iterations in each task. Lowering it can help cancel an optimization that will not converge.
		Default: 400-->
		<max_iterations>100</max_iterations>
		<!--*Optional* Integer
		Description: Maximum number of cost function calls in each task. Lowering it can help cancel an optimization that will not converge.
		Default: 300000-->
		<max_function_evaluations>300000</max_function_evaluations>
	</GroundContactPersonalizationTool>
</NMSMPipelineDocument>